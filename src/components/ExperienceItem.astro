---
interface Props {
  role: string;
  company: string;
  location: string;
  date: string;
  bullets: string[];
}

const { role, company, location, date, bullets } = Astro.props;
---

<div class="relative pl-8 pb-12 last:pb-4 group">
  <!-- Vertical Timeline Connector Line -->
  <div class="absolute left-[11px] top-2 bottom-0 w-0.5 bg-slate-200 dark:bg-slate-800 group-last:hidden"></div>
  
  <!-- Timeline Dot -->
  <div class="absolute left-0 top-1.5 w-6 h-6 rounded-full bg-white dark:bg-[#0a0f1d] border-2 border-teal-500 flex items-center justify-center shadow-sm z-10 transition-transform duration-300 group-hover:scale-110">
    <div class="w-2.5 h-2.5 rounded-full bg-cyan-500"></div>
  </div>

  <div class="glow-hover bg-white/40 dark:bg-[#121a2e]/40 backdrop-blur-md border border-slate-200/50 dark:border-slate-800/50 rounded-2xl p-6 sm:p-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
      <div>
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-teal-500 transition-colors">
          {role}
        </h3>
        <p class="text-sm font-semibold text-teal-600 dark:text-teal-400">
          {company} <span class="text-slate-400 font-normal">| {location}</span>
        </p>
      </div>
      <div class="text-xs sm:text-sm font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-full self-start sm:self-center">
        {date}
      </div>
    </div>
    
    <ul class="space-y-2.5">
      {bullets.map((bullet) => (
        <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          <span class="mt-2 w-1.5 h-1.5 rounded-full bg-cyan-500 shrink-0"></span>
          <span>{bullet}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
