---
interface Props {
  title: string;
  subtitle: string;
  tags: string[];
  bullets: string[];
  githubUrl?: string;
  demoUrl?: string;
}

const { title, subtitle, tags, bullets, githubUrl, demoUrl } = Astro.props;
---

<div class="glow-hover bg-white/40 dark:bg-[#121a2e]/40 backdrop-blur-md border border-slate-200/50 dark:border-slate-800/50 rounded-2xl p-6 sm:p-8 flex flex-col justify-between">
  <div>
    <div class="flex flex-wrap items-center justify-between gap-4 mb-2">
      <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">{title}</h3>
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold flex items-center gap-1.5 px-3 py-1 rounded-full border border-teal-500/30 text-teal-600 dark:text-teal-400 hover:bg-teal-500/10 transition-all">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          GitHub
        </a>
      )}
    </div>
    
    <p class="text-sm font-medium text-teal-600 dark:text-teal-400 mb-4">{subtitle}</p>
    
    <!-- Tags -->
    <div class="flex flex-wrap gap-2 mb-6">
      {tags.map((tag) => (
        <span class="text-xs px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium">
          {tag}
        </span>
      ))}
    </div>

    <!-- Bullets -->
    <ul class="space-y-3 mb-6">
      {bullets.map((bullet) => (
        <li class="flex items-start gap-2.5 text-sm text-slate-600 dark:text-slate-300">
          <svg class="w-4 h-4 mt-0.5 text-teal-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{bullet}</span>
        </li>
      ))}
    </ul>
  </div>
  
  {demoUrl && (
    <div class="mt-4 pt-4 border-t border-slate-200/50 dark:border-slate-800/50">
      <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-semibold text-cyan-600 dark:text-cyan-400 hover:text-teal-500 transition-colors">
        Live Demo
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  )}
</div>
