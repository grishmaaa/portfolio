---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';

// Skills grouped by category for visual cards
const skillCategories = [
  {
    title: "Languages",
    skills: ["C++ (Advanced: C++17/20)", "CUDA C++", "Python", "C"]
  },
  {
    title: "LLM Inference & Optimization",
    skills: ["Inference latency optimization", "Throughput optimization", "KV cache", "PagedAttention (vLLM)", "FlashAttention", "TensorRT", "ONNX", "Quantization (INT8/FP16/BF16)", "Operator fusion", "Kernel fusion"]
  },
  {
    title: "AI & Systems Architecture",
    skills: ["Automatic Differentiation (Backpropagation, VJP)", "Computational Graphs", "Lazy Gradient Materialization", "SavedVariable Mechanics", "Compiler Frontend Design (IR)", "MLIR/LLM", "Deep Learning Framework Architecture", "PyTorch internals", "HPC"]
  },
  {
    title: "CUDA & GPU Programming",
    skills: ["CUDA Kernels", "PTX Inspection & Optimization", "CUDA Streams", "CUDA Graphs", "cuBLAS", "Warp-level primitives", "Memory bandwidth optimization", "H2D/D2H Transfer Optimization", "Shared memory optimization"]
  },
  {
    title: "CPU Optimization",
    skills: ["AVX2", "OpenMP", "Mixed precision training (FP16/BF16)", "Distributed training concepts", "NCCL"]
  },
  {
    title: "Profiling & Debugging",
    skills: ["Nsight Systems", "Nsight Compute", "Intel VTune", "AMD uProf", "GDB", "Roofline model analysis"]
  },
  {
    title: "Frameworks & Tools",
    skills: ["PyTorch", "Git", "CMake", "Make", "Docker", "Kubernetes", "Flask", "MySQL", "MongoDB"]
  },
  {
    title: "Developer Tooling",
    skills: ["Claude Code", "Codex", "Cursor", "OpenClaw", "Antigravity", "Workflow automation"]
  }
];
---

<Layout 
  title="M Grishma | ML Infrastructure Engineer" 
  description="Personal portfolio of M Grishma, ML Infrastructure Engineer specializing in LLM inference optimization, custom CUDA kernels, and compiler design."
>
  <!-- Hero Section -->
  <section id="hero" class="pt-8 pb-16 md:py-20 flex flex-col-reverse lg:flex-row items-center justify-between gap-12">
    <div class="flex-1 space-y-6 text-center lg:text-left">
      <div class="inline-flex items-center gap-2 px-3  py-1 rounded-full border border-teal-500/30 bg-teal-500/10 text-teal-700 dark:text-teal-400 text-xs sm:text-sm font-semibold tracking-wide">
        <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
        Available for AI & Systems Roles
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tight text-slate-900 dark:text-white">
        Hi, I'm <span class="bg-gradient-to-r from-teal-400 via-cyan-500 to-blue-500 bg-clip-text text-transparent">M Grishma</span>
      </h1>
      <p class="text-xl sm:text-2xl font-bold text-slate-700 dark:text-slate-200">
        ML Infrastructure & Systems Engineer
      </p>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        I specialize in LLM inference optimization and GPU-accelerated deep learning systems. From building a production-grade autograd engine in C++/CUDA from scratch to implementing custom CUDA kernels and reducing inference latency, I focus on turning cutting-edge ML research into highly optimized, production-ready systems.
      </p>
      
      <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-4">
        <a 
          href="/portfolio/grishma_resume.pdf" 
          download 
          class="px-6 py-3 rounded-xl bg-gradient-to-r from-teal-500 to-cyan-500 hover:from-teal-600 hover:to-cyan-600 text-white font-bold shadow-lg shadow-teal-500/20 hover:shadow-teal-500/30 transition-all flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download Resume
        </a>
        <a 
          href="#projects" 
          class="px-6 py-3 rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-[#121a2e]/50 hover:bg-slate-50 dark:hover:bg-[#121a2e]/80 text-slate-700 dark:text-slate-300 font-bold transition-all"
        >
          View Projects
        </a>
      </div>
    </div>
    
    <!-- Premium Interactive Visual (ML Compiler / Autograd Representation) -->
    <div class="w-64 h-64 sm:w-80 sm:h-80 lg:w-96 lg:h-96 shrink-0 relative flex items-center justify-center select-none">
      <div class="absolute inset-0 bg-gradient-to-tr from-teal-500 to-cyan-500 rounded-full blur-3xl opacity-10 dark:opacity-20 animate-pulse"></div>
      
      <!-- Interactive SVG representing an Autograd Computation Graph -->
      <svg class="w-full h-full text-slate-400 dark:text-slate-600" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Connecting Path lines -->
        <path d="M40 100 L100 50 M40 100 L100 150 M100 50 L160 100 M100 150 L160 100 M100 50 L100 150" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" class="text-teal-500/40" />
        <path d="M40 100 H160" stroke="currentColor" stroke-width="2" class="text-cyan-500/30" />
        
        <!-- Forward propagation pulses -->
        <circle r="4" fill="#06b6d4">
          <animateMotion dur="4s" repeatCount="indefinite" path="M40 100 L100 50 L160 100" />
        </circle>
        <circle r="4" fill="#14b8a6">
          <animateMotion dur="5s" repeatCount="indefinite" path="M40 100 L100 150 L160 100" />
        </circle>
        
        <!-- Graph Nodes -->
        <!-- Input Node -->
        <circle cx="40" cy="100" r="14" class="fill-white dark:fill-[#121a2e] stroke-teal-500" stroke-width="3" />
        <text x="40" y="104" text-anchor="middle" font-family="sans-serif" font-size="10" font-weight="bold" class="fill-slate-800 dark:fill-teal-400">X</text>
        
        <!-- Hidden Node 1 -->
        <circle cx="100" cy="50" r="16" class="fill-white dark:fill-[#121a2e] stroke-cyan-500" stroke-width="3" />
        <text x="100" y="54" text-anchor="middle" font-family="sans-serif" font-size="10" font-weight="bold" class="fill-slate-800 dark:fill-cyan-400">VJP</text>
        
        <!-- Hidden Node 2 (Autograd) -->
        <circle cx="100" cy="150" r="16" class="fill-white dark:fill-[#121a2e] stroke-cyan-500" stroke-width="3" />
        <text x="100" y="154" text-anchor="middle" font-family="sans-serif" font-size="9" font-weight="bold" class="fill-slate-800 dark:fill-cyan-400">CUDA</text>
        
        <!-- Output Node -->
        <circle cx="160" cy="100" r="14" class="fill-white dark:fill-[#121a2e] stroke-blue-500" stroke-width="3" />
        <text x="160" y="104" text-anchor="middle" font-family="sans-serif" font-size="10" font-weight="bold" class="fill-slate-800 dark:fill-blue-400">Y</text>
        
        <!-- Micro-labels -->
        <text x="65" y="65" font-family="sans-serif" font-size="7" class="fill-slate-400 dark:fill-slate-500">forward</text>
        <text x="135" y="145" font-family="sans-serif" font-size="7" class="fill-slate-400 dark:fill-slate-500">backward</text>
      </svg>
    </div>
  </section>

  <!-- About / Overview Highlights -->
  <section id="about" class="py-16 border-t border-slate-200/50 dark:border-slate-800/50 scroll-mt-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="md:col-span-1">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          About Me
        </h2>
        <div class="w-16 h-1 bg-gradient-to-r from-teal-500 to-cyan-500 mt-3 rounded-full"></div>
      </div>
      <div class="md:col-span-2 space-y-6 text-slate-600 dark:text-slate-350">
        <p class="leading-relaxed">
          I am a B.Tech graduate in Computer Science Engineering from Presidency University, Bangalore, with a passion for systems programming, compiler optimization, and high-performance computing (HPC) for AI.
        </p>
        <p class="leading-relaxed">
          Throughout my engineering journey and industry experience, I have dedicated myself to diving deep into the internals of popular frameworks like PyTorch and optimizing deep learning computations. My core projects and work experiences focus on accelerating workloads, designing JIT compiler frontends, managing tensor lifecycles, and writing optimized CUDA kernels to maximize GPU active times.
        </p>
        
        <!-- Quick stats / badges -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4">
          <div class="p-4 rounded-xl border border-slate-200/50 dark:border-slate-800/50 bg-white/40 dark:bg-[#121a2e]/30">
            <div class="text-2xl font-bold text-teal-500 dark:text-teal-400">52K</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wider">tokens/sec throughput</div>
          </div>
          <div class="p-4 rounded-xl border border-slate-200/50 dark:border-slate-800/50 bg-white/40 dark:bg-[#121a2e]/30">
            <div class="text-2xl font-bold text-cyan-500 dark:text-cyan-400">99%</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wider">GPU Active Time</div>
          </div>
          <div class="p-4 rounded-xl border border-slate-200/50 dark:border-slate-800/50 bg-white/40 dark:bg-[#121a2e]/30 col-span-2 sm:col-span-1">
            <div class="text-2xl font-bold text-blue-500 dark:text-blue-400">C++20</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 font-semibold uppercase tracking-wider">Framework Architecture</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Work Experience Section -->
  <section id="experience" class="py-16 border-t border-slate-200/50 dark:border-slate-800/50 scroll-mt-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-1">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Work Experience
        </h2>
        <p class="text-slate-500 dark:text-slate-400 mt-2">Professional experience in machine learning systems and tooling.</p>
        <div class="w-16 h-1 bg-gradient-to-r from-teal-500 to-cyan-500 mt-3 rounded-full"></div>
      </div>
      <div class="lg:col-span-2">
        <div class="relative pl-2">
          <ExperienceItem 
            role="AI Systems Engineer"
            company="BluBridge"
            location="Chennai, India"
            date="July 2025 – March 2026"
            bullets={[
              "Team lead — architected and built a production C++/CUDA deep learning framework; scoped and delegated four parallel workstreams: ABI adapter, gradient checkpointing, MLIR/LLM compiler, and autograd hooks infrastructure.",
              "Designed the core autograd engine — VJP-based reverse-mode AD over a dynamic computation graph with AutogradMeta + MetaInterface for deferred, on-demand gradient materialization — achieving 52K tokens/sec on RTX 3060 + Intel i9-14700.",
              "Engineered serial and parallel backward pass execution across CPU and GPU backends; introduced SavedVariable to cut peak memory pressure and cached BFS traversal to eliminate repeated graph walks per iteration.",
              "Built the full execution pipeline around a custom async dispatcher, sustaining 99% GPU active time and 68% average SM occupancy across training workloads.",
              "Used Nsight Systems & Compute, VTune, and uProf to eliminate redundant H2D/D2H transfers; inspected PTX output to identify and apply PTX-level optimizations (loop unrolling, instruction scheduling); optimized backward CUDA kernels for memory access patterns and occupancy."
            ]}
          />
          <ExperienceItem 
            role="Machine Learning Intern"
            company="D4 Insights"
            location="Chennai, India"
            date="July 2024 – August 2024"
            bullets={[
              "Built and optimized ML models for predictive analytics pipelines; worked on feature engineering and model evaluation for business intelligence applications."
            ]}
          />
          <ExperienceItem 
            role="ML and Neural Net Intern"
            company="Azure Skynets"
            location="Remote"
            date="June 2024 – July 2024"
            bullets={[
              "Fine-tuned neural network models for AI applications; applied transfer learning and performance benchmarking to improve inference accuracy and latency metrics."
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="py-16 border-t border-slate-200/50 dark:border-slate-800/50 scroll-mt-20">
    <div class="space-y-4 mb-8">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white text-center">
        Featured Projects
      </h2>
      <div class="w-16 h-1 bg-gradient-to-r from-teal-500 to-cyan-500 mx-auto rounded-full"></div>
      <p class="text-center text-slate-500 dark:text-slate-400 max-w-xl mx-auto">
        Deep dive into my custom framework development, compiler implementation, and high-performance kernel design.
      </p>
    </div>
    
    <div class="grid grid-cols-1 gap-8 max-w-4xl mx-auto">
      <ProjectCard 
        title="Cortex: Production C++ Deep Learning Framework"
        subtitle="C++/CUDA, PyTorch-comparable architecture"
        tags={["C++20", "CUDA C++", "Autograd", "Compiler Frontend", "Nsight Systems", "HPC"]}
        bullets={[
          "Architected an eager-execution deep learning framework in C++20 with a dynamic computational graph and robust reverse-mode automatic differentiation engine — comparable in design to PyTorch's autograd internals.",
          "Implemented the core Autodiff engine with VJP (Vector-Jacobian Product) rules for 50+ operations; solved a critical broadcasting bug ensuring gradient correctness across all tensor shapes.",
          "Engineered backend-agnostic architecture with a dynamic plugin system; optimized CPU (AVX2, OpenMP) and GPU (cuBLAS, CUDA) backends for maximum throughput; applied kernel fusion and memory bandwidth optimizations.",
          "Designed a JIT compiler frontend lowering the dynamic graph into a linear Intermediate Representation (IR) for compatibility with CUDA Graphs and backend optimizers; applied operator fusion and mixed precision (FP16/BF16) support.",
          "Achieved 52K tokens/sec sustained throughput with 99% GPU active time and 68% SM occupancy on RTX 3060 — profiled and optimized using Nsight Compute and roofline model analysis."
        ]}
        githubUrl="https://github.com/grishmaaa/cortex"
      />
    </div>
  </section>

  <!-- Technical Skills Section -->
  <section id="skills" class="py-16 border-t border-slate-200/50 dark:border-slate-800/50 scroll-mt-20">
    <div class="space-y-4 mb-10">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white text-center">
        Technical Skills
      </h2>
      <div class="w-16 h-1 bg-gradient-to-r from-teal-500 to-cyan-500 mx-auto rounded-full"></div>
      <p class="text-center text-slate-500 dark:text-slate-400 max-w-xl mx-auto">
        A deep breakdown of the technologies and practices I leverage to build high-performance systems.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {skillCategories.map((cat) => (
        <div class="p-6 rounded-2xl border border-slate-200/50 dark:border-slate-800/50 bg-white/40 dark:bg-[#121a2e]/40 backdrop-blur-sm flex flex-col hover:border-teal-500/30 transition-colors">
          <h3 class="text-base font-bold text-slate-800 dark:text-slate-200 border-b border-slate-200/50 dark:border-slate-800/50 pb-2 mb-3">
            {cat.title}
          </h3>
          <div class="flex flex-wrap gap-1.5 mt-auto">
            {cat.skills.map((skill) => (
              <span class="text-xs px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-355 font-medium border border-slate-200/20 dark:border-slate-700/20">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Education Section -->
  <section id="education" class="py-16 border-t border-slate-200/50 dark:border-slate-800/50">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="md:col-span-1">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Education
        </h2>
        <div class="w-16 h-1 bg-gradient-to-r from-teal-500 to-cyan-500 mt-3 rounded-full"></div>
      </div>
      <div class="md:col-span-2">
        <div class="glow-hover bg-white/40 dark:bg-[#121a2e]/40 backdrop-blur-md border border-slate-200/50 dark:border-slate-800/50 rounded-2xl p-6 sm:p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                B.Tech in Computer Science Engineering
              </h3>
              <p class="text-sm font-semibold text-teal-600 dark:text-teal-400">
                Presidency University, Bangalore
              </p>
            </div>
            <div class="text-xs sm:text-sm font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-full self-start sm:self-center">
              Graduation: July 2025
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-16 border-t border-slate-200/50 dark:border-slate-800/50 scroll-mt-20">
    <div class="max-w-3xl mx-auto text-center space-y-6">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Get In Touch
      </h2>
      <div class="w-16 h-1 bg-gradient-to-r from-teal-500 to-cyan-500 mx-auto rounded-full"></div>
      <p class="text-slate-500 dark:text-slate-400 max-w-lg mx-auto">
        Feel free to reach out via email or connect with me on GitHub and LinkedIn. Let's discuss performance, compilers, or CUDA optimizations!
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-6 pt-4">
        <!-- Email Link -->
        <a 
          href="mailto:grishma.renuka@gmail.com" 
          class="flex items-center gap-2 px-5 py-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#121a2e] hover:border-teal-500/40 text-slate-700 dark:text-slate-300 font-semibold transition-all group"
        >
          <svg class="w-5 h-5 text-slate-400 group-hover:text-teal-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          grishma.renuka@gmail.com
        </a>

        <!-- LinkedIn Link -->
        <a 
          href="https://linkedin.com/in/grishma-m" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center gap-2 px-5 py-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#121a2e] hover:border-cyan-500/40 text-slate-700 dark:text-slate-300 font-semibold transition-all group"
        >
          <svg class="w-5 h-5 text-slate-400 group-hover:text-cyan-500 transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/>
          </svg>
          linkedin.com/in/grishma-m
        </a>

        <!-- GitHub Link -->
        <a 
          href="https://github.com/grishmaaa" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center gap-2 px-5 py-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#121a2e] hover:border-blue-500/40 text-slate-700 dark:text-slate-300 font-semibold transition-all group"
        >
          <svg class="w-5 h-5 text-slate-400 group-hover:text-blue-500 transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          github.com/grishmaaa
        </a>
      </div>
    </div>
  </section>
</Layout>
