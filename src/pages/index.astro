---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="M Grishma | ML Infrastructure Engineer" 
  description="ML Infrastructure and Systems Engineer specializing in C++/CUDA framework architecture and LLM inference optimization."
>
  <!-- Hero Section -->
  <section id="hero" class="min-h-[85vh] flex flex-col lg:flex-row items-center justify-between gap-12 pt-8 pb-16 lg:py-24">
    <div class="flex-1 space-y-8 text-left max-w-xl">
      <div class="space-y-4">
        <h1 class="text-[#F8FAFC] font-bold tracking-tight leading-[1.05]" style="font-size: var(--font-size-display);">
          M Grishma
        </h1>
        <p class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-slate-500 font-mono">
          ML Infrastructure & Systems Engineer
        </p>
      </div>
      
      <p class="text-lg md:text-xl font-bold text-slate-200 tracking-tight leading-relaxed">
        I build the infrastructure that makes AI fast.
      </p>
      
      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a 
          href="#projects" 
          class="px-5 py-2.5 rounded text-xs font-mono font-bold tracking-wider uppercase bg-[#00C9A7] text-[#0A0E17] hover:bg-[#00C9A7]/90 transition-all"
        >
          View Projects
        </a>
        <a 
          href="/portfolio/grishma_resume.pdf" 
          download
          class="px-5 py-2.5 rounded text-xs font-mono font-bold tracking-wider uppercase border border-slate-700 text-slate-300 hover:border-[#00C9A7] hover:text-[#00C9A7] transition-all"
        >
          Download Resume
        </a>
      </div>
    </div>
    
    <!-- Code Snippet Side Panel -->
    <div class="w-full lg:w-[460px] shrink-0 font-mono text-[11px] sm:text-xs text-slate-500 leading-normal p-6 bg-slate-950/40 border border-slate-900 rounded-lg select-none text-left">
      <div class="flex justify-between items-center pb-3 border-b border-slate-900 mb-4 text-[10px] uppercase tracking-wider text-slate-600">
        <span>fused_vjp.cu</span>
        <span class="text-[#00C9A7]">CUDA C++</span>
      </div>
      <pre><code><span class="text-[#00C9A7]">template</span> &lt;<span class="text-[#00C9A7]">typename</span> T&gt;
<span class="text-[#00C9A7]">__global__</span> <span class="text-[#00C9A7]">void</span> <span class="text-slate-300">fused_vjp_kernel</span>(<span class="text-[#00C9A7]">const</span> T* dy, <span class="text-[#00C9A7]">const</span> T* x, T* dx, <span class="text-[#00C9A7]">int</span> n) &#123;
    <span class="text-[#00C9A7]">int</span> idx = blockIdx.x * blockDim.x + threadIdx.x;
    <span class="text-[#00C9A7]">if</span> (idx &lt; n) &#123;
        dx[idx] = dy[idx] * (1.0f - x[idx] * x[idx]);
    &#125;
&#125;</code></pre>
    </div>
  </section>

  <!-- Stats Strip -->
  <section class="border-y border-slate-900 py-12 mb-20">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-left">
      <div class="space-y-1">
        <div class="text-3xl sm:text-4xl font-bold font-mono text-white tracking-tight">52K <span class="text-xs text-slate-600">tok/s</span></div>
        <div class="text-[10px] sm:text-xs font-mono uppercase tracking-widest text-slate-500">Inference Throughput</div>
      </div>
      <div class="space-y-1">
        <div class="text-3xl sm:text-4xl font-bold font-mono text-white tracking-tight">99%</div>
        <div class="text-[10px] sm:text-xs font-mono uppercase tracking-widest text-slate-500">GPU Active Time</div>
      </div>
      <div class="space-y-1">
        <div class="text-3xl sm:text-4xl font-bold font-mono text-white tracking-tight">C++20</div>
        <div class="text-[10px] sm:text-xs font-mono uppercase tracking-widest text-slate-500">Engine Core</div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-16 scroll-mt-24 fade-in-section">
    <div class="border-l-2 border-[#00C9A7] pl-6 md:pl-8 space-y-4">
      <h2 class="font-bold tracking-tight text-white uppercase font-mono tracking-widest text-xs text-slate-500">
        01 / About
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl">
        I am an AI Systems Engineer focused on LLM inference optimization, automatic differentiation framework internals, and high-performance CUDA kernel acceleration. I bridge the gap between high-level machine learning abstractions and GPU metal. By inspecting compiling pipelines and profiling latency bottlenecks, I engineer low-overhead training and inference pipelines designed for production scaling.
      </p>
    </div>
  </section>

  <!-- Work Experience Section -->
  <section id="experience" class="py-16 border-t border-slate-900 scroll-mt-24 fade-in-section">
    <div class="space-y-8">
      <h2 class="font-bold tracking-tight text-white uppercase font-mono tracking-widest text-xs text-slate-500">
        02 / Experience
      </h2>
      
      <div class="space-y-2">
        <!-- BluBridge (Expanded by Default) -->
        <details open class="group border border-slate-900 bg-slate-950/20 rounded-md overflow-hidden transition-all duration-300">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none select-none hover:bg-slate-900/30 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
              <span class="text-sm font-semibold tracking-wider uppercase font-mono text-[#00C9A7]">BluBridge</span>
              <span class="text-sm font-bold text-white">AI Systems Engineer</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-slate-500">July 2025 – March 2026</span>
              <svg class="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="p-6 pt-0 border-t border-slate-900/60 text-xs sm:text-sm text-slate-400 space-y-3 leading-relaxed">
            <p class="font-semibold text-slate-300">Key Infrastructure Contributions:</p>
            <ul class="list-disc list-inside space-y-2.5 pl-2">
              <li>Team lead — architected and built a production <code class="text-[#00C9A7] font-mono">C++/CUDA</code> deep learning framework; scoped and delegated four parallel workstreams: ABI adapter, gradient checkpointing, MLIR/LLM compiler, and autograd hooks.</li>
              <li>Designed the core autograd engine — VJP-based reverse-mode AD over a dynamic computation graph with <code class="text-[#00C9A7] font-mono">AutogradMeta</code> + <code class="text-[#00C9A7] font-mono">MetaInterface</code> for deferred, on-demand gradient materialization — achieving 52K tokens/sec on RTX 3060.</li>
              <li>Engineered serial and parallel backward pass execution across CPU and GPU backends; introduced <code class="text-[#00C9A7] font-mono">SavedVariable</code> to cut peak memory pressure and cached BFS traversal to eliminate repeated graph walks per iteration.</li>
              <li>Built the full execution pipeline around a custom async dispatcher, sustaining 99% GPU active time and 68% average SM occupancy.</li>
              <li>Used Nsight Systems & Compute, VTune, and uProf to eliminate redundant H2D/D2H transfers; inspected PTX output to apply PTX-level optimizations (loop unrolling, instruction scheduling); optimized CUDA kernels for memory bandwidth and warp-level primitives.</li>
            </ul>
          </div>
        </details>

        <!-- D4 Insights -->
        <details class="group border border-slate-900 bg-slate-950/10 rounded-md overflow-hidden transition-all duration-300">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none select-none hover:bg-slate-900/30 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
              <span class="text-sm font-semibold tracking-wider uppercase font-mono text-[#00C9A7]">D4 Insights</span>
              <span class="text-sm font-bold text-white">Machine Learning Intern</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-slate-500">July 2024 – August 2024</span>
              <svg class="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="p-6 pt-0 border-t border-slate-900/60 text-xs sm:text-sm text-slate-400 space-y-3 leading-relaxed">
            <ul class="list-disc list-inside space-y-2 pl-2">
              <li>Built and optimized ML models for predictive analytics pipelines; worked on feature engineering and model evaluation for business intelligence applications.</li>
            </ul>
          </div>
        </details>

        <!-- Azure Skynets -->
        <details class="group border border-slate-900 bg-slate-950/10 rounded-md overflow-hidden transition-all duration-300">
          <summary class="flex justify-between items-center p-6 cursor-pointer list-none select-none hover:bg-slate-900/30 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
              <span class="text-sm font-semibold tracking-wider uppercase font-mono text-[#00C9A7]">Azure Skynets</span>
              <span class="text-sm font-bold text-white">ML and Neural Net Intern</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono text-slate-500">June 2024 – July 2024</span>
              <svg class="w-4 h-4 text-slate-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="p-6 pt-0 border-t border-slate-900/60 text-xs sm:text-sm text-slate-400 space-y-3 leading-relaxed">
            <ul class="list-disc list-inside space-y-2 pl-2">
              <li>Fine-tuned neural network models for AI applications; applied transfer learning and performance benchmarking to improve inference accuracy and latency metrics.</li>
            </ul>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="py-16 border-t border-slate-900 scroll-mt-24 fade-in-section">
    <div class="space-y-8">
      <h2 class="font-bold tracking-tight text-white uppercase font-mono tracking-widest text-xs text-slate-500">
        03 / Projects
      </h2>
      
      <!-- Cortex Product Launch Style Card -->
      <div class="flex flex-col lg:flex-row gap-8 p-8 border border-slate-900 bg-slate-950/20 rounded-md">
        <div class="flex-1 space-y-6">
          <div class="space-y-2">
            <h3 class="text-2xl font-bold text-white tracking-tight">Cortex</h3>
            <p class="text-xs font-mono text-[#00C9A7] italic">C++/CUDA production deep learning framework built from scratch</p>
          </div>
          
          <div class="flex flex-wrap gap-2">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded border border-slate-800 text-slate-400">C++20</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded border border-slate-800 text-slate-400">CUDA C++</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded border border-slate-800 text-slate-400">Autograd</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded border border-slate-800 text-slate-400">JIT Compiler</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded border border-slate-800 text-slate-400">cuBLAS</span>
          </div>

          <div class="space-y-3 text-sm text-slate-350">
            <p class="leading-relaxed">
              · Architected an eager-execution engine with custom reverse-mode automatic differentiation (VJP rules) matching PyTorch's internal designs.
            </p>
            <p class="leading-relaxed">
              · Optimized compiler pipelines lowering graphs into a linear Intermediate Representation (IR) compatible with CUDA Graphs and mixed-precision (FP16/BF16) operators.
            </p>
            <p class="leading-relaxed">
              · Achieved 52K tokens/sec sustained throughput with 99% GPU active time and 68% SM occupancy on RTX 3060, verified through Nsight Compute profiling.
            </p>
          </div>

          <div class="pt-4">
            <a 
              href="https://github.com/grishmaaa/cortex" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 px-4 py-2 rounded text-xs font-mono font-bold tracking-wider uppercase border border-slate-800 text-slate-300 hover:border-[#00C9A7] hover:text-[#00C9A7] transition-all"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
              </svg>
              Repository
            </a>
          </div>
        </div>
        
        <!-- Terminal Block Panel -->
        <div class="w-full lg:w-[320px] shrink-0 bg-slate-950 border border-slate-900 rounded p-5 font-mono text-[10px] leading-relaxed text-slate-500 self-center">
          <div class="flex justify-between items-center text-slate-600 border-b border-slate-900 pb-2 mb-3">
            <span>nsight_profile.log</span>
            <span class="w-2 h-2 rounded-full bg-[#00C9A7]"></span>
          </div>
          <div class="space-y-1.5 text-left">
            <p class="text-slate-400">>> launch profiling: cortex_train</p>
            <p>>> analyzing memory bandwidth utilization...</p>
            <p>>> registers per thread: 64 | warp size: 32</p>
            <p>>> grid size: 1024 | block size: 256</p>
            <p class="text-[#00C9A7]">>> sustained: 52,134 tok/s | GPU util: 99% | SM occ: 68%</p>
            <p class="text-slate-600">>> profiling complete. zero overflows.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Skills Section -->
  <section id="skills" class="py-16 border-t border-slate-900 scroll-mt-24 fade-in-section">
    <div class="space-y-10">
      <h2 class="font-bold tracking-tight text-white uppercase font-mono tracking-widest text-xs text-slate-500">
        04 / Skills
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <!-- Col 1: CUDA & GPU -->
        <div class="space-y-4">
          <div class="flex items-center gap-2.5 pb-2 border-b border-slate-900">
            <!-- Chip / Hardware Icon -->
            <svg class="w-4 h-4 text-[#00C9A7]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="4" y="4" width="16" height="16" rx="2" />
              <path d="M9 9h6v6H9z M9 1v3 M15 1v3 M9 20v3 M15 20v3 M1 9h3 M1 15h3 M20 9h3 M20 15h3" />
            </svg>
            <h3 class="text-sm font-semibold tracking-wider uppercase font-mono text-white">CUDA & GPU Programming</h3>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {["CUDA Kernels", "PTX Inspection", "Warp Primitives", "Shared Memory", "Memory Bandwidth", "H2D/D2H", "Streams", "Graphs", "cuBLAS"].map(skill => (
              <span class="text-[10px] font-mono px-2 py-0.5 bg-slate-950 border border-slate-900 rounded text-slate-400">{skill}</span>
            ))}
          </div>
        </div>

        <!-- Col 2: AI Architecture -->
        <div class="space-y-4">
          <div class="flex items-center gap-2.5 pb-2 border-b border-slate-900">
            <!-- Circuit / Node Icon -->
            <svg class="w-4 h-4 text-[#00C9A7]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5 M2 12l10 5 10-5" />
            </svg>
            <h3 class="text-sm font-semibold tracking-wider uppercase font-mono text-white">AI & Systems Architecture</h3>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {["LLM Inference", "PagedAttention", "FlashAttention", "Autograd Internals", "VJP Rules", "SavedVariable", "JIT Compiler", "IR Optimization", "Quantization", "NCCL", "Nsight", "VTune"].map(skill => (
              <span class="text-[10px] font-mono px-2 py-0.5 bg-slate-950 border border-slate-900 rounded text-slate-400">{skill}</span>
            ))}
          </div>
        </div>

        <!-- Col 3: Languages & Tools -->
        <div class="space-y-4">
          <div class="flex items-center gap-2.5 pb-2 border-b border-slate-900">
            <!-- Code / Terminal Icon -->
            <svg class="w-4 h-4 text-[#00C9A7]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <h3 class="text-sm font-semibold tracking-wider uppercase font-mono text-white">Languages & Tools</h3>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {["C++17/20", "CUDA C++", "Python", "PyTorch", "CMake", "Git", "Docker", "Kubernetes", "MLIR"].map(skill => (
              <span class="text-[10px] font-mono px-2 py-0.5 bg-slate-950 border border-slate-900 rounded text-slate-400">{skill}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Education Section -->
  <section id="education" class="py-16 border-t border-slate-900 fade-in-section">
    <div class="space-y-4 text-left">
      <h2 class="font-bold tracking-tight text-white uppercase font-mono tracking-widest text-xs text-slate-500">
        05 / Education
      </h2>
      <p class="text-sm font-semibold text-slate-300">
        B.Tech in Computer Science Engineering <span class="text-slate-600 font-normal">·</span> Presidency University, Bangalore <span class="text-slate-600 font-normal">·</span> July 2025
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-16 border-t border-slate-900 scroll-mt-24 fade-in-section">
    <div class="space-y-8 text-left">
      <div class="space-y-2">
        <h2 class="text-3xl font-bold text-white tracking-tight">Get in touch</h2>
        <p class="text-sm text-slate-500">Let's discuss GPU profiling, performance bottlenecks, or AI infrastructure engineering roles.</p>
      </div>
      
      <div class="flex flex-col sm:flex-row gap-6 pt-4 font-mono text-xs">
        <a 
          href="mailto:grishma.renuka@gmail.com" 
          class="flex items-center gap-2 text-slate-400 hover:text-[#00C9A7] transition-colors"
        >
          <svg class="w-4 h-4 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          grishma.renuka@gmail.com
        </a>
        <a 
          href="https://linkedin.com/in/grishma-m" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center gap-2 text-slate-400 hover:text-[#00C9A7] transition-colors"
        >
          <svg class="w-4 h-4 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/>
          </svg>
          linkedin.com/in/grishma-m
        </a>
        <a 
          href="https://github.com/grishmaaa" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center gap-2 text-slate-400 hover:text-[#00C9A7] transition-colors"
        >
          <svg class="w-4 h-4 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          github.com/grishmaaa
        </a>
      </div>
    </div>
  </section>
</Layout>
